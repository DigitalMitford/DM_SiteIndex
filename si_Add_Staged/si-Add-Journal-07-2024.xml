         <div type="places">
            <listPlace sortKey="histPlaces">
             
             
            
              
               
              
               <place xml:id="Ilsley"> <!-- NEW ENTRY -->
                  <placeName>Ilsley</placeName>
                  <district type="county">Berkshire</district>
                  <country>England</country>
                  <location>
                     <geo>51.53243230753439 -1.3008503913281573</geo>
                  </location>
                  <note resp="#hjb">Unknown if this is either East or West Ilsey. Drum often visited, dates including <date when="1819-11-29">November 29, 1821</date>, <date when="1820-11-27">November 27, 1821</date>, and <date when="1821-11-19">November 19, 1821</date>.</note>
               </place>
               <place xml:id="Kew_village"> <!-- UPDATING ENTRY WITH MITFORD ASSOCIATION -->
                  <placeName>Kew, Richmond upon Thames, England</placeName>
                  <placeName>
                     <addName>Kew village</addName>
                  </placeName>
                  <settlement>Kew</settlement>
                  <region>Richmond upon Thames</region>
                  <country>England</country>
                  <location>
                     <geo>51.475251 -0.284890799999971</geo>
                  </location>
                  <note resp="#lmw">Once a village northeast of Richmond, now a suburban district
                     part of the London Borough of Richmond upon Thames. Site of what is now the
                     Royal Botanic Gardens, a World Heritage Site, which includes Kew Palace, a
                     royal residence favored by <persName ref="#GeoIII">George III</persName>, and
                     Kew Gardens. Visited by <persName ref="#MRM">Mitford</persName> on <date when="1820-07-04">July 4 1820</date>.</note>
               </place>
               <place xml:id="PaperMill_Marlow"> <!-- UPDATING ENTRY WITH LOTS OF STUFF -->
                  <placeName>Paper mill on the Thames</placeName>
                  <placeName>Arborfield Mill</placeName>
                  <district>Marlow</district>
                  <region>Berkshire</region>
                  <country>England</country>
                  <location>
                     <geo>51.406 -0.926</geo>
                  </location>
                  <note resp="#hjb">
                     <ref target="http://www.arborfieldhistory.org.uk/properties.htm"/>
                     <ref target="http://www.arborfieldhistory.org.uk/properties_mill.htm"/>
                     <ref target="https://en.wikipedia.org/wiki/Arborfield_Hall"/>
                  </note>
                  <note resp="#hjb">In Mitford's time, this was a paper mill that used a 48-inch paper machine. Most likely produced fine brown paper. 
                     Visited by Mitford on <date when="1820-08-29">Tuesday 29th, 1820</date>, and <date when="1819-10-12">Tuesday 12 October, 1819</date>.</note>
               </place>
               <place xml:id="Overton"> <!--UPDATE: ADDING JOURNAL MENTIONS -->
                  <placeName>Overton</placeName>
                  <region>Hampshire</region>
                  <country>England</country>
                  <location>
                     <geo>51.2439 -1.2615</geo>
                  </location>
                  <note resp="#lmw #hjb">Large parish. In 1831, the Hundred of Overton contained Ashe,
                     Bradley, Deane, Laverstoke, Overton, Tadley, and North Waltham. Overton Mill
                     has produced banknote paper since the eighteenth century. <persName ref="#Russell_Richard">Richard Russell</persName> lived here as vicar of
                     Overton and rector of Ashe and Deane. Visited by <persName ref="#Mitford_Geo">Drum</persName> on <date when="1821-11-25">November 25 1821</date>.</note>
                  <note>
                     <ptr target="https://www.british-history.ac.uk/vch/hants/vol4/p197"/>
                  </note>
                  <note>
                     <ptr target="https://www.british-history.ac.uk/vch/hants/vol4/pp210-219"/>
                  </note>
                  <!-- https://www.stmarysoverton.org.uk/history.php [the dickers family have a plaque in the church] -->
               </place>
               <place xml:id="Park_Windsor"> <!-- NEW ENTRY -->
                  <placeName>Windsor Park</placeName>
                  <district>Windsor</district>
                  <region>Berkshire</region>
                  <country>England</country>
                  <location>
                     <geo>51.439167 -0.624722</geo>
                  </location>
                  <note resp="#hjb"><persName ref="#MRM">Mitford</persName> rode through on <date when="1820-06-27">June 27, 1820</date>.</note>
               </place>
               <place xml:id="Saint_Amand"> <!-- Don't remember why this is here. ebb: Not finding a reference to this in the Journal, wondering if this is part of the French cookbook info? 
               -->
                  <placeName>Saint-Amand-Montrond</placeName>
                  <district type="department">Cher</district>
                  <region>Centre-Val de Loire</region>
                  <country>France</country>
                  <note resp="#hjb">Commune in France.</note>
               </place>
               <place xml:id="Newbery_house_St_Queen33"> <!-- NEW ENTRY -->
                  <placeName>33 Great Queen Street</placeName>
                  <region>London</region>
                  <country>England</country>
                  <location>
                     <geo>51.515305662435175, -0.12163909072409469</geo>
                  </location>
                  <note resp="#hjb">A specific address on <placeName ref="#St_QueenG">Great Queen Street</placeName>. 
                     Most likely owned by <persName ref="#Newbery_J">Mr. Newbery</persName>. 
                     Mentioned by <persName ref="#MRM">Mitford</persName> on <date when="1820-12-05">5 December 1820</date>, 
                     <q><persName ref="#Newbery_J">Mr. Newbery</persName>'s, 33 Great Queen Street, which we had all to ourselves</q></note>
               </place>
               <place xml:id="St_QueenG"> <!-- NEW ENTRY -->
                  <placeName>Great Queen Street</placeName>
                  <region>London</region>
                  <country>England</country>
                  <location>
                     <geo>51.51571315852602 -0.12101546898777185</geo>
                  </location>
                  <note resp="#hjb">Mentioned by <persName ref="#MRM">Mitford</persName> on <date when="1820-06-27">June 27 1820</date>, 
                     <date when="1820-06-28">June 28 1820</date>, and <date when="1820-12-05">December 5 1820</date>.</note>
               </place>
               <place xml:id="Tadley"> <!-- NEW ENTRY -->
                  <placeName>Tadley</placeName>
                  <district type="county">Hampshire</district>
                  <region>South East</region>
                  <country>England</country>
                  <location>
                     <geo>51.3506 -1.1376</geo>
                  </location>
                  <note>Village that <persName ref="#MRM">Mitford</persName> travels to with her father and the dogs while coursing on 
                     <date when="1820-11-10">10 November 1820</date>. They visit here after stopping in <placeName ref="#Aldermaston">Aldermaston</placeName>.</note>
               </place>
               <place xml:id="Opera_House"> <!-- NEW ENTRY -->
                  <placeName notAfter="1830">English Opera House</placeName>
                  <placeName notBefore="1834">New Theatre Royal, Lyceum and English Opera House</placeName>
                  <region>London</region>
                  <country>England</country>
                  <location>
                     <geo>51.511683730658035 -0.12006460946319568</geo>
                  </location>
                  <note resp="#hjb">
                     <ref target="https://www.regencyhistory.net/blog/lyceum-theatre-regency-history-guide-london"/>
                     <ref target="https://en.wikipedia.org/wiki/Lyceum_Theatre,_London"/>
                  </note>
                  <note resp="#hjb">Was known as the <q>English Opera House</q> until it burnt down in 1830. 
                     It was then rebuilt and reopened as the Theatre Royal Lyceum &amp; English Opera House in 1834. 
                     After threats to demolish the building by London City Council, the theatre closed in 1939. It then reopened after the war and renamed itself the Lyceum Ballroom. 
                     Was then closed in 1986 but then reopened for theatrical use as the Lyceum Theatre. Mitford mentions in her Journal on <date when="1820-06-29">June 29, 1820</date> 
                     that she was going to London to see <persName>Miss Kelly</persName> perform here.</note>
               </place>
               <place xml:id="W_Hill_OV"> <!-- REPAIRED ENTRY FROM SI -->
                  <placeName ref="#W_Hill_OV">W. Hill</placeName>
                  <note resp="#scw">A steep, corkscrew-like hill described in <title ref="#Great_Farmhouse_OV">A Great Farmhouse</title> on which the farmer's greyhound, Helen proudly kills an old
                     hare. This might be a mappable place in England, but further research is needed.</note>
                  <!--scw: This place might be locatable. Check to see whether it's mentioned in first sketch-->
               </place>
            </listPlace>
         </div>

         <div type="nature">

            <list sortKey="animals">
          
               <item xml:id="butterfly"> <!-- UPDATED -->
                  <name>butterfly</name>
                  <note resp="#alw #lmw #srr">
                     Mitford mentions seeing <q>a most beautiful butterfly</q> in the grounds near her home in her Journal 
                     on <date when="1819-09-19">19 September 1819</date>. Insect of the order Lepidoptera with two pairs of large wings that are covered with tiny scales, 
                     usually brightly colored, and typically held erect when at rest.</note>
                  <note>
                     <ptr target="https://species.wikimedia.org/wiki/Lepidoptera"/>
                  </note>
                  <note>
                     <ptr target="https://www.woodlandtrust.org.uk/trees-woods-and-wildlife/animals/butterflies/"/>
                  </note>
               </item>
            </list>
         </div>

